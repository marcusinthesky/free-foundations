# Downloads, model weights and expensive intermediates live in DVC's cache and the
# Hugging Face bucket (dvc.yaml, *.dvc); Git keeps their pointers and DVC's own
# .gitignore files.
research/**/cache/*
!research/**/cache/*.dvc
!research/**/cache/.gitignore
# Generated numerical results, contexts and detailed manifests are DVC outputs.
# Protocols and inexpensive human-readable reports remain in Git.
research/**/*.parquet
research/**/*.npz
research/**/embeddings/
research/crsp-study/sources/
research/crsp-study/prepared/
research/crsp-study/representations/
research/crsp-study/measurement/
research/crsp-study/replication/
research/crsp-study/publication/
research/crsp-study/recovery/
research/crsp-study/.sources.lock
# Per-distance fingerprints: thousands of sidecars, cached by DVC with their matrices.
research/panel/**/distances/
# Generated blueprint declaration lists; the sources are src/lean/blueprint/src.
src/lean/blueprint/manuscript_decls
